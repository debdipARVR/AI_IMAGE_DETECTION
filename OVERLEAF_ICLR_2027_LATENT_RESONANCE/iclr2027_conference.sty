\def\maketitle{\par
 \begingroup
   \def\thefootnote{\fnsymbol{footnote}}
   \def\@makefnmark{\hbox to 0pt{$^{\@thefnmark}$\hss}}
   \@maketitle \@thanks
 \endgroup
 \setcounter{footnote}{0}
 \let\maketitle\relax \let\@maketitle\relax
 \gdef\@thanks{}\gdef\@author{}\gdef\@title{}\let\thanks\relax}

\def\@maketitle{\vbox{\hsize\textwidth
 \linewidth\hsize \vskip 0.1in \toptitlebar \centering
 {\LARGE\bf \@title\par}
 \bottomtitlebar \vskip 0.1in
 \ifcase 0\@iclrfinalcopy
   {\def\and{\unskip\enspace{\rm and}\enspace}%
    \def\And{\end{tabular}\hss \egroup \hskip 1in plus 2fil
             \bgroup \hsize 5.5in \centering \begin{tabular}[t]{c}\bf}%
    \def\AND{\end{tabular}\hss\egroup \hfil\hfil\egroup
             \vskip 0.25in plus 1fil
             \bgroup \hsize 5.5in \centering \begin{tabular}[t]{c}\bf}
   \begin{tabular}[t]{c}\bf Anonymous Authors \\
   Paper under double-blind review at ICLR 2027
   \end{tabular}}
 \else
   {\def\and{\unskip\enspace{\rm and}\enspace}%
    \def\And{\end{tabular}\hss \egroup \hskip 0.5in plus 2fil
             \bgroup \centering \begin{tabular}[t]{c}\bf}%
    \def\AND{\end{tabular}\hss\egroup \hfil\hfil\egroup
             \vskip 0.25in plus 1fil
             \bgroup \centering \begin{tabular}[t]{c}\bf}
   \begin{tabular}[t]{c}\bf \@author \end{tabular}}
 \fi
 \vskip 0.3in minus 0.1in}}

